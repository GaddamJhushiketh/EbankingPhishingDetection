FLASK_ENV=development
FLASK_DEBUG=1
# Development: if omitted, a random process-local key is generated.
# Production requires a long random SECRET_KEY.
SECRET_KEY=
MODEL_SHA256=
DOMAIN_INFO_PROVIDER=whois
DOMAIN_INFO_TIMEOUT=3
# Leave unset: no historical Dataset 379 traffic provider is verified.
TRAFFIC_PROVIDER=
DATABASE_URL=sqlite:///history.db
# MySQL alternative:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=phishing
# DB_USER=phishing
# DB_PASSWORD=
HOST=127.0.0.1
PORT=8000
